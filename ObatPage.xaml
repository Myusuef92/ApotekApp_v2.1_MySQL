<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="ApotekApp.ObatPage" BackgroundColor="#F8FAFC">
<Grid RowDefinitions="Auto,Auto,*" Padding="24">
    <HorizontalStackLayout Grid.Row="0" Spacing="8" HorizontalOptions="End" Margin="0,0,0,12">
            <Button Text="🔄  Refresh" Clicked="OnRefreshClicked" BackgroundColor="White" TextColor="#334155" BorderColor="#CBD5E1" BorderWidth="1" CornerRadius="8" HeightRequest="42" Padding="16,0" />
            <Button Text="Import CSV" Clicked="OnImportClicked" BackgroundColor="#008000" TextColor="White"/>
            <Button Text="Export CSV" Clicked="OnExportClicked" BackgroundColor="#FF0000" TextColor="White"/>
            <Button Text="+ Tambah Obat" Clicked="OnTambahObatClicked" BackgroundColor="#2563EB" TextColor="White"/>
    </HorizontalStackLayout>
    <Entry Grid.Row="1" x:Name="TxtSearch" Placeholder="Cari kode, nama, barcode atau kategori..." TextChanged="OnSearchTextChanged" Margin="0,0,0,12"/>
    <Border Grid.Row="2" BackgroundColor="White" Stroke="#CBD5E1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="0" VerticalOptions="FillAndExpand">
        <Grid RowDefinitions="Auto,*">
            <Grid Grid.Row="0" Padding="12" ColumnDefinitions="55,120,*,90,100,130,170" BackgroundColor="#E2E8F0">
                <Label Text="NO" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="1" Text="KODE" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="2" Text="NAMA OBAT" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="3" Text="STOK" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="4" Text="SATUAN" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="5" Text="HARGA JUAL" FontAttributes="Bold" TextColor="#334155"/><Label Grid.Column="6" Text="AKSI" FontAttributes="Bold" TextColor="#334155"/>
            </Grid>
            <CollectionView Grid.Row="1" x:Name="CvObatList" SelectionMode="None" VerticalOptions="FillAndExpand" MinimumHeightRequest="260">
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
                        <Label Text="Data obat belum tersedia" FontSize="16" FontAttributes="Bold" TextColor="#64748B" HorizontalTextAlignment="Center"/>
                        <Label Text="Tambahkan data obat atau tekan Refresh." TextColor="#94A3B8" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8" ColumnDefinitions="55,120,*,90,100,130,170" BackgroundColor="White" HeightRequest="48">
                            <Label Text="{Binding No}" TextColor="#475569" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding KodeObat}" TextColor="#334155" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text="{Binding NamaObat}" TextColor="#0F172A" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                            <Label Grid.Column="3" Text="{Binding Stok}" TextColor="#334155" VerticalOptions="Center"/>
                            <Label Grid.Column="4" Text="{Binding Satuan}" TextColor="#334155" VerticalOptions="Center"/>
                            <Label Grid.Column="5" Text="{Binding HargaFormatted}" TextColor="#0F172A" VerticalOptions="Center"/>
                            <HorizontalStackLayout Grid.Column="6" Spacing="6">
                              <Button Text="Edit" Clicked="OnEditClicked" CommandParameter="{Binding .}" HeightRequest="34" BackgroundColor="#FFA500" TextColor="#282828"/>
                                    <Button Text="Hapus" Clicked="OnHapusClicked" CommandParameter="{Binding .}" HeightRequest="34" BackgroundColor="#FF0000" TextColor="#282828"/>
                               </HorizontalStackLayout>
                                    </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Border>
    <Grid x:Name="ModalLayout" Grid.RowSpan="3" IsVisible="False" BackgroundColor="#990F172A">
        <Border HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="560" MaximumHeightRequest="700" BackgroundColor="White" Stroke="#CBD5E1" StrokeShape="RoundRectangle 16" Padding="24">
            <ScrollView><VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label x:Name="LblModalTitle" Text="Tambah Obat" FontSize="21" FontAttributes="Bold" TextColor="#0F172A"/><Label Text="Lengkapi data obat dengan jelas sebelum disimpan." FontSize="12" TextColor="#64748B"/></VerticalStackLayout><Button Grid.Column="1" Text="✕" Clicked="OnBatalClicked" BackgroundColor="#F1F5F9" TextColor="#475569" WidthRequest="42" HeightRequest="42" Padding="0"/></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4"><Label Text="Kode Obat *" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtKode" Placeholder="Contoh: OBT001" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Barcode" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtBarcode" Placeholder="Barcode obat" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout>
                </Grid>
                <VerticalStackLayout Spacing="4"><Label Text="Nama Obat *" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtNama" Placeholder="Nama lengkap obat" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="4"><Label Text="Kategori" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtKategori" Placeholder="Contoh: Analgesik" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Lokasi Rak" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtLokasi" Placeholder="Contoh: Rak A1" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="4"><Label Text="Satuan" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtSatuan" Placeholder="Strip / Botol / Sachet" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Stok" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtStok" Placeholder="0" Keyboard="Numeric" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="4"><Label Text="Stok Minimum" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtStokMin" Placeholder="0" Keyboard="Numeric" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Tanggal Kedaluwarsa" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><DatePicker x:Name="DtpExpired" Format="dd/MM/yyyy" TextColor="#0F172A"/></Border></VerticalStackLayout></Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><VerticalStackLayout Spacing="4"><Label Text="Harga Beli" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtHargaBeli" Placeholder="Rp 0" Keyboard="Numeric" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout><VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Harga Jual" FontSize="12" FontAttributes="Bold" TextColor="#334155"/><Border Stroke="#CBD5E1" StrokeShape="RoundRectangle 8" Padding="8,0"><Entry x:Name="TxtHargaJual" Placeholder="Rp 0" Keyboard="Numeric" TextColor="#0F172A" PlaceholderColor="#94A3B8"/></Border></VerticalStackLayout></Grid>
                <HorizontalStackLayout HorizontalOptions="End" Spacing="8"><Button Text="Batal" Clicked="OnBatalClicked" BackgroundColor="#E2E8F0" TextColor="#334155"/><Button Text="💾 Simpan Data" Clicked="OnSimpanClicked" BackgroundColor="#16A34A" TextColor="White" FontAttributes="Bold"/></HorizontalStackLayout>
            </VerticalStackLayout></ScrollView>
        </Border>
    </Grid>
</Grid>
</ContentPage>
